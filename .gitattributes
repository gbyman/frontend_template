# 기본 설정
* text=auto eol=lf

# JavaScript/TypeScript 파일
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf

# 설정 파일
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 스타일 파일
*.css text eol=lf

# 마크다운
*.md text eol=lf

